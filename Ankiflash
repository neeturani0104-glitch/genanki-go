import genanki

my_model = genanki.Model(
  1607392319,
  'Simple Model',
  fields=[
    {'name': 'Question'},
    {'name': 'Answer'},
  ],
  templates=[
    {
      'name': 'Card 1',
      'qfmt': '{{Question}}',
      'afmt': '{{FrontSide}}<hr id="answer">{{Answer}}',
    },
  ])

my_deck = genanki.Deck(
  2059400110,
  'Motion in 1D and 2D - JEE Advanced'
)

flashcards = [
  ["What is the difference between displacement and distance?", "Displacement is a vector; distance is a scalar."],
  ["At the highest point in projectile motion, what is velocity and acceleration?", "Velocity is horizontal, acceleration is -g vertically."],
  ["What is the range of a projectile on level ground?", "R = (u^2 * sin2θ)/g"],
  ["Is acceleration zero at turning point?", "No. Acceleration = -g; velocity = 0."],
  ["Explain relative velocity in rain-man problems.", "Use vector subtraction: Vr = Vman - Vrain."],
  ["Why is motion in a circle considered accelerated?", "Because direction of velocity changes, creating centripetal acceleration a = v^2/r."],
  ["What is trajectory equation of a projectile?", "y = x tanθ - (gx²)/(2u² cos²θ) — a parabola."],
  ["Can speed be constant while acceleration exists?", "Yes, in circular motion where direction changes but speed is constant."],
  ["Describe graph of uniformly accelerated motion (v–t graph).", "Straight line with non-zero slope."],
  ["When is average velocity = (u + v)/2 valid?", "Only in constant acceleration cases."],
]

for q, a in flashcards:
  my_deck.add_note(genanki.Note(
    model=my_model,
    fields=[q, a]
  ))

genanki.Package(my_deck).write_to_file('/content/Motion_1D_2D_JEE.apkg')
